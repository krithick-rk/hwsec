# HWSEC Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to source control.

# ────────────────────────────────────────────
# LLM Provider API Keys (at least one required)
# ────────────────────────────────────────────

# NVIDIA NIM API key (https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google Gemini API keys (https://aistudio.google.com/)
# Supports up to 9 keys for round-robin pool across authorized projects
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# OpenRouter API key (https://openrouter.ai/) — specialist fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ────────────────────────────────────────────
# Hardware Analysis Tools (optional)
# ────────────────────────────────────────────

# Path to OSS CAD Suite installation root (https://github.com/YosysHQ/oss-cad-suite-build)
# Used by Verilator, Yosys, and SymbiYosys adapters.
# Example (Linux/WSL): OSS_CAD_SUITE=/opt/oss-cad-suite
# Example (Windows):   OSS_CAD_SUITE=C:/tools/oss-cad-suite
# OSS_CAD_SUITE=/path/to/oss-cad-suite

# Alternative: set YOSYSHQ_ROOT if using a YosysHQ distribution
# YOSYSHQ_ROOT=/path/to/yosyshq

# ────────────────────────────────────────────
# Software Analysis Tools (optional)
# ────────────────────────────────────────────

# Path to Joern CLI root directory (https://joern.io/)
# The adapter looks for ${JOERN_HOME}/joern-cli
# Example: JOERN_HOME=/opt/joern
# JOERN_HOME=/path/to/joern

# ────────────────────────────────────────────
# Vector Memory (optional)
# ────────────────────────────────────────────

# Qdrant vector database URL (https://qdrant.tech/)
# Start with: docker run -d -p 6333:6333 qdrant/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
