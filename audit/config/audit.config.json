  "resource_limits": {
    "max_file_size_bytes": 10485760,
    "max_files": 10000,
    "max_directory_depth": 20,
    "max_total_input_bytes": 104857600,
    "max_tool_output_bytes": 52428800,
    "max_process_runtime_ms": 120000,
    "max_concurrent_tools": 4,
    "max_graph_nodes": 50000,
    "max_llm_tokens": 100000,
    "max_embeddings": 10000,
    "max_database_growth_bytes": 524288000
  },
  "security_gates": {
    "block_on_critical": true,
    "block_on_high": true,
    "min_readiness_score": 8.0,
    "required_controls": [
      "EXECUTION_INJECTION_DEFENSE",
      "FILESYSTEM_ESCAPE_DEFENSE",
      "VERIFIER_SUBSTRING_BAN",
      "ARTIFACT_PROVENANCE_HMAC_SHA256",
      "CODEGRAPH_LIVE_POPULATION",
      "INCREMENTAL_HASH_ENFORCEMENT",
      "QDRANT_PROJECT_ISOLATION"
    ]
  },
  "scoring_weights": {
    "execution_security": 0.15,
    "filesystem_security": 0.10,
    "tool_isolation": 0.10,
    "evidence_integrity": 0.15,
    "verifier_integrity": 0.10,
    "graph_integrity": 0.08,
    "rag_integrity": 0.08,
    "llm_security": 0.06,
    "database_integrity": 0.06,
    "incremental_analysis": 0.06,
    "performance": 0.06
  }
}
