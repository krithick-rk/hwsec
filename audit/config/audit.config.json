{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "HWSEC Security & Adversarial Validation Framework Configuration",
  "version": "1.0.0",
  "profiles": {
    "quick": {
      "description": "Fast smoke check of critical security invariants and evidence integrity",
      "suites": [
