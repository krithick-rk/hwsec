    },
    "full": {
      "description": "Complete adversarial, architectural, evidence, and stress validation suite",
      "suites": [
        "security/execution_injection.adversarial.js",
        "security/filesystem_traversal.adversarial.js",
        "security/process_isolation.adversarial.js",
        "security/symlink_escape.adversarial.js",
        "evidence/verifier_integrity.adversarial.js",
        "evidence/artifact_provenance.adversarial.js",
        "evidence/cross_domain_evidence.adversarial.js",
        "evidence/telemetry_poisoning.adversarial.js",
        "graph/codegraph_live.integration.js",
        "rag/qdrant_isolation.integration.js",
        "llm/prompt_injection.adversarial.js",
        "llm/gateway_telemetry.security.js",
        "integration/incremental_lifecycle.integration.js",
