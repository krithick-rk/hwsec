{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalFinding",
  "type": "object",
  "required": ["finding_id", "case_id", "cwe", "analyzer", "source_file", "source_locations"],
  "properties": {
    "finding_id": { "type": "string" },
    "case_id": { "type": "string" },
    "cwe": { "type": "string" },
    "analyzer": { "type": "string" },
    "analyzer_version": { "type": "string" },
    "source_file": { "type": "string" },
    "source_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "line"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "column": { "type": "integer" }
        }
      }
    },
    "source_boundary": { "type": "string" },
    "sink": { "type": "string" },
    "path_hint": { "type": "array", "items": { "type": "string" } },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "rule_id": { "type": "string" },
    "timestamp": { "type": "string" }
  },
  "additionalProperties": false
}
