{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaintResult",
  "type": "object",
  "required": [
    "case_id",
    "source_observed",
    "sink_observed",
    "sink_tainted",
    "runtime_path",
    "exit_code",
    "timeout",
    "instrumentation_status",
    "artifact_hashes"
  ],
  "properties": {
    "case_id": { "type": "string" },
    "source_observed": { "type": "string" },
    "sink_observed": { "type": "string" },
    "sink_tainted": { "type": "boolean" },
    "runtime_path": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exit_code": { "type": "integer" },
    "timeout": { "type": "boolean" },
    "instrumentation_status": {
      "type": "string",
      "enum": ["ACTIVE", "UNAVAILABLE", "PARTIAL", "FAILED"]
    },
    "execution_time_ms": { "type": "number" },
    "timestamp": { "type": "string" },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
